# Neon PostgreSQL connection string (pooled recommended for serverless)
# Format: postgresql://username:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/compiler_db"

# Optional JWT/Session secret if auth is used
NEXTAUTH_SECRET="super-secret-compiler-key"
